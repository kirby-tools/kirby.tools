{
  "name": "kirby-tools-website",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier \"**/*.{css,html,json,md,mjs,ts,vue,yml}\" --write",
    "format:check": "prettier \"**/*.{css,html,json,md,mjs,ts,vue,yml}\" --check",
    "test": "vitest run",
    "test:types": "vue-tsc -b --noEmit",
    "kirby-panel:fetch": "node layers/kirby-panel/scripts/fetch-kirby.ts",
    "docs:logo-metrics": "logo-soup --output=\"app/data/logo-metrics.json\" public/img/brands",
    "docs:social-cards": "node scripts/social-cards.ts",
    "docs:vanished-facts": "node scripts/vanished-facts.ts",
    "prepare": "pnpm run kirby-panel:fetch && nuxt prepare && pnpm run docs:logo-metrics"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@colordx/core": "^7.3.0",
    "@iconify-json/fluent": "^1.2.60",
    "@iconify-json/lucide": "^1.2.146",
    "@iconify-json/ri": "^1.2.10",
    "@iconify-json/simple-icons": "^1.2.100",
    "@iconify-json/vscode-icons": "^1.2.91",
    "@nuxt/content": "^3.16.2",
    "@nuxt/image": "^2.2.0",
    "@nuxt/kit": "^4.6.2",
    "@nuxt/ui": "^4.12.0",
    "@nuxtjs/robots": "^7.0.2",
    "@nuxtjs/sitemap": "^9.1.0",
    "@paddle/paddle-js": "^1.6.5",
    "@takumi-rs/core": "^2.17.0",
    "@takumi-rs/wasm": "^2.17.0",
    "@types/node": "^26.6.5",
    "@vueuse/core": "^14.4.0",
    "@vueuse/nuxt": "^14.4.0",
    "eslint": "^10.13.0",
    "logo-soup": "^0.2.3",
    "minimark": "^0.2.0",
    "motion-v": "^2.8.0",
    "nuxt": "^4.6.2",
    "nuxt-llms": "^0.2.0",
    "nuxt-og-image": "^7.0.7",
    "playwright-core": "^1.64.1",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prosemirror-model": "^1.25.12",
    "scule": "^1.3.0",
    "sharp": "^0.35.5",
    "shiki": "^4.5.0",
    "tailwindcss": "^4.3.3",
    "tinyexec": "1.2.4",
    "typescript": "^6.0.3",
    "ufo": "^1.6.4",
    "utilful": "^3.5.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13",
    "wrangler": "^4.151.2"
  }
}
