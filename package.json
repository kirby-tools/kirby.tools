{
  "name": "kirby-tools-website",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier \"**/*.{css,html,json,md,mjs,ts,vue,yml}\" --write",
    "format:check": "prettier \"**/*.{css,html,json,md,mjs,ts,vue,yml}\" --check",
    "test": "vitest run",
    "test:types": "vue-tsc -b --noEmit",
    "logo-soup:metrics": "logo-soup --output=\"app/data/logo-metrics.json\" public/img/brands",
    "kirby:fetch": "node layers/kirby-panel/scripts/fetch-kirby.ts",
    "prepare": "pnpm run kirby:fetch && nuxt prepare && pnpm run logo-soup:metrics"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@colordx/core": "^6.2.0",
    "@iconify-json/logos": "^1.2.13",
    "@iconify-json/lucide": "^1.2.128",
    "@iconify-json/ri": "^1.2.10",
    "@iconify-json/simple-icons": "^1.2.94",
    "@iconify-json/vscode-icons": "^1.2.76",
    "@nuxt/content": "^3.16.0",
    "@nuxt/image": "^2.1.0",
    "@nuxt/kit": "^4.5.2",
    "@nuxt/ui": "^4.11.0",
    "@nuxtjs/robots": "^6.2.0",
    "@nuxtjs/sitemap": "^8.5.0",
    "@paddle/paddle-js": "^1.6.5",
    "@takumi-rs/core": "^2.13.4",
    "@takumi-rs/wasm": "^2.13.4",
    "@types/node": "^26.4.1",
    "@vue/shared": "^3.5.42",
    "@vueuse/nuxt": "^14.4.0",
    "eslint": "^10.9.1",
    "logo-soup": "^0.2.3",
    "minimark": "^0.2.0",
    "motion-v": "^2.4.0",
    "nuxt": "^4.5.2",
    "nuxt-llms": "^0.2.0",
    "nuxt-og-image": "^6.7.8",
    "nuxtseo-layer-devtools": "^5.3.14",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "scule": "^1.3.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "tinyexec": "1.2.4",
    "typescript": "^6.0.3",
    "ufo": "^1.6.4",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11",
    "wrangler": "^4.128.0"
  }
}
