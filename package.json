{
  "name": "kirby-tools-website",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier \"**/*.{css,html,json,md,mjs,ts,vue,yml}\" --write",
    "format:check": "prettier \"**/*.{css,html,json,md,mjs,ts,vue,yml}\" --check",
    "test": "vitest run",
    "test:types": "vue-tsc -b --noEmit",
    "logo-soup:metrics": "logo-soup --output=\"app/data/logo-metrics.json\" public/img/brands",
    "prepare": "nuxt prepare && pnpm run logo-soup:metrics"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.2.0",
    "@iconify-json/logos": "^1.2.11",
    "@iconify-json/lucide": "^1.2.121",
    "@iconify-json/ri": "^1.2.10",
    "@iconify-json/simple-icons": "^1.2.92",
    "@iconify-json/vscode-icons": "^1.2.68",
    "@nuxt/content": "^3.15.2",
    "@nuxt/image": "^2.1.0",
    "@nuxt/ui": "^4.10.0",
    "@nuxtjs/robots": "^6.1.3",
    "@nuxtjs/sitemap": "^8.3.2",
    "@paddle/paddle-js": "^1.6.4",
    "@takumi-rs/core": "^2.5.4",
    "@takumi-rs/wasm": "^2.5.4",
    "@types/node": "^26.1.2",
    "@vue/shared": "^3.5.40",
    "@vueuse/nuxt": "^14.4.0",
    "eslint": "^10.8.0",
    "logo-soup": "^0.2.3",
    "minimark": "^0.2.0",
    "motion-v": "^2.3.0",
    "nuxt": "^4.5.1",
    "nuxt-llms": "^0.2.0",
    "nuxt-og-image": "^6.7.5",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "scule": "^1.3.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "ufo": "^1.6.4",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9"
  }
}
