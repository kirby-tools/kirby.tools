{
  "name": "kirby-tools-website",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.23.0",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier \"**/*.{css,html,json,md,mjs,ts,vue,yml}\" --write",
    "format:check": "prettier \"**/*.{css,html,json,md,mjs,ts,vue,yml}\" --check",
    "test": "vitest run",
    "test:types": "vue-tsc -b --noEmit",
    "kirby-panel:fetch": "node layers/kirby-panel/scripts/fetch.ts",
    "docs:logo-metrics": "logo-soup --output=\"app/data/logo-metrics.json\" public/img/brands",
    "docs:pngs": "node scripts/pngs.ts",
    "prepare": "pnpm run kirby-panel:fetch && nuxt prepare && pnpm run docs:logo-metrics"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@colordx/core": "^7.5.0",
    "@iconify-json/fluent": "^1.2.62",
    "@iconify-json/lucide": "^1.2.160",
    "@iconify-json/ri": "^1.2.10",
    "@iconify-json/simple-icons": "^1.2.104",
    "@iconify-json/vscode-icons": "^1.2.100",
    "@kirby-tools/licensing": "^1.1.0",
    "@nuxt/content": "^3.17.0",
    "@nuxt/image": "^2.2.1",
    "@nuxt/kit": "^4.7.0",
    "@nuxt/ui": "^4.13.1",
    "@nuxtjs/robots": "^7.1.0",
    "@nuxtjs/sitemap": "^9.2.0",
    "@paddle/paddle-js": "^1.6.6",
    "@takumi-rs/core": "^2.22.1",
    "@takumi-rs/wasm": "^2.22.1",
    "@types/node": "^26.6.11",
    "@vueuse/core": "^15.1.0",
    "@vueuse/nuxt": "^15.1.0",
    "eslint": "^10.15.0",
    "kirby-types": "^2.0.0",
    "kirbyuse": "^2.0.0",
    "logo-soup": "^0.3.1",
    "minimark": "^1.0.0",
    "motion-v": "^2.13.0",
    "nuxt": "^4.7.0",
    "nuxt-llms": "^0.3.2",
    "nuxt-og-image": "^7.2.1",
    "p-throttle": "^8.1.1",
    "playwright-core": "^1.65.1",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prosemirror-model": "^1.25.13",
    "scule": "^1.3.0",
    "sharp": "^0.35.5",
    "shiki": "^4.6.0",
    "tailwindcss": "^4.3.5",
    "tinyexec": "1.2.4",
    "typescript": "^6.0.3",
    "ufo": "^1.6.4",
    "utilful": "^3.6.1",
    "vite": "^8.4.0",
    "vitest": "^5.1.2",
    "vue": "^3.5.46",
    "vue-tsc": "^3.3.13",
    "wrangler": "^4.168.0"
  }
}
